# Copy this file to .env and fill in the real values from the Neon console.
# .env is ignored by Git. NEVER put real credentials in this file.

# Pooled connection (hostname contains "-pooler"). Used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ep-example-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Direct connection (hostname has NO "-pooler"). Used by Prisma migrations.
DIRECT_URL="postgresql://USER:PASSWORD@ep-example.REGION.aws.neon.tech/neondb?sslmode=require"

# --- Added for OpenRaiz 3.0 (placeholders only; real values go in .env) ---

# Comma-separated emails treated as administrators. Checked on the server.
ADMIN_EMAILS="you@example.com"

# Gemini API key for Job-Fit and Interview Coach. Server-only: never prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=""

# Set to "false" to switch every AI feature off (kill switch).
AI_ENABLED="true"

# Neon Auth (Step 3). The Auth URL is under Settings > Better Auth > Project Info in the Neon console (per branch).
NEON_AUTH_BASE_URL="https://ep-example.neonauth.REGION.aws.neon.tech/neondb/auth"
# At least 32 characters. Generate with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=""

# AI features (Job-Fit, interview coach, translation drafts). The key stays on the server: never prefix it with NEXT_PUBLIC_.
# Optional: AI_ENABLED="false" turns every AI feature off. GEMINI_MODEL overrides the default model.
# Optional daily limits per feature (whole numbers): AI_CAP_JOB_FIT, AI_CAP_INTERVIEW, AI_CAP_TRANSLATE.
GEMINI_MODEL=""
