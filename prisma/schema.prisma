// Prisma schema for OpenRaiz 2.0.
// Enum values are the original OpenRaiz values (data/opportunities.json), unchanged.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  // The connection URL is NOT set here. In Prisma 7 it lives in prisma.config.ts
  // (and the app passes its own URL to the client through the pg adapter).
}

enum OpportunityType {
  job
  internship
  fellowship
  volunteer
  workshop
  event // shown as "Event / meetup"
  resource
}

// Who may see a listing: only "approved" ones are public. New posts from people start as "pending".
enum ApprovalStatus {
  pending
  approved
  rejected
}

enum LivedExperienceRelevance {
  required
  preferred
  welcomed
  relevant
}

// An expired deadline does NOT change the stored status. Expiry is computed from
// `deadline` when listings are displayed. `archived` listings stay in the database
// but will be excluded from the public directory.
enum OpportunityStatus {
  active
  filled
  archived
}

enum LocationType {
  remote
  hybrid
  onsite
}

enum ApplyMethodType {
  url
  email
  platform // people contact the poster through OpenRaiz (step P4); no link or email is shown
}

// Where the translated text of a listing stands. Only "approved" translations are shown as normal text.
enum TranslationStatus {
  none
  ai_draft
  approved
}

model Opportunity {
  id                       String                   @id @default(cuid())
  // Readable ID from the original OpenRaiz site (e.g. "2026-community-health-fellow-001").
  // Unique when present; empty for opportunities created in OpenRaiz 2.0.
  legacyId                 String?                  @unique
  title                    String
  organization             String
  description              String
  type                     OpportunityType
  livedExperienceRelevance LivedExperienceRelevance
  status                   OpportunityStatus        @default(active)
  source                   String                   @default("owner-added")

  // Original `location` object, flattened. city/state/address are empty for remote.
  locationType LocationType
  city         String?
  state        String?
  address      String?

  isPaid       Boolean
  compensation String

  // Calendar dates (no time of day). datePosted is the opportunity's publication date.
  datePosted DateTime  @db.Date
  deadline   DateTime? @db.Date // empty = rolling, no cutoff

  // When this row was created in the OpenRaiz 2.0 database. Not the same as datePosted.
  createdAt DateTime @default(now())

  // Set by Prisma to today whenever this row changes in OpenRaiz 2.0. The original
  // site's own lastUpdated dates (set by hand) must be preserved when importing;
  // see PROMPT_LOG.md (Step 2.5) for how that will be verified before any import.
  lastUpdated DateTime @updatedAt @db.Date

  // Original `applyMethod` object, flattened.
  applyMethodType  ApplyMethodType
  applyMethodValue String

  summary      String? // a short blurb for cards and search (up to 280 characters)
  requirements String?
  skills       String[]
  category     String? // one of the categories in lib/opportunityTaxonomy.js
  commitment   String? // for example "4 hours a week"
  eventDate    DateTime? @db.Date // workshops and events only

  // The title, summary, description and requirements above are written in `originalLang` ("en" or "es").
  // The *Tr columns hold the same text in the other language, once someone has translated it.
  originalLang      String            @default("en")
  titleTr           String?
  summaryTr         String?
  descriptionTr     String?
  requirementsTr    String?
  translationStatus TranslationStatus @default(none)

  approvalStatus  ApprovalStatus @default(pending) // safe default: not public until approved
  rejectionReason String?
  ownerUserId     String? // the poster's Neon Auth user id; empty means OpenRaiz itself

  @@index([approvalStatus, status])
  @@index([ownerUserId])

  messages ContactMessage[]
}

enum ProfileRole {
  individual
  organization
}

// One row per signed-in account (Neon Auth user). Admin is NOT stored here: it is worked out from ADMIN_EMAILS.
model Profile {
  id          String      @id @default(cuid())
  userId      String      @unique // the Neon Auth user id (neon_auth.user.id)
  role        ProfileRole
  displayName String
  orgName     String? // set when role is organization
  createdAt   DateTime    @default(now())
}

// A message a signed-in person sent to the poster of a listing that uses "contact through OpenRaiz". The sender's name and
// kind of account are copied here when it is sent. `contact` is whatever the sender chose to share so the poster can reply
// outside OpenRaiz (there is no email or in-app reply yet).
model ContactMessage {
  id            String      @id @default(cuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  senderUserId  String
  senderName    String
  senderRole    ProfileRole
  contact       String?
  body          String
  createdAt     DateTime    @default(now())

  @@index([opportunityId, createdAt])
  @@index([senderUserId, createdAt])
}
